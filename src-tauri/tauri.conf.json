{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pico Live Assistant",
  "version": "1.0.14",
  "identifier": "com.pico.live-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pico Live Assistant",
        "width": 820,
        "height": 700,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/adb/*": "adb/",
      "resources/tesseract-macos/**/*": "tesseract/",
      "resources/tesseract-windows/**/*": "tesseract/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxOTk2QjUzMTIyN0YxNUIKUldSYjhTY1NVMnVaY1NYWXNUQ2c1WDdYaE9hdHg1dmNSZDE3eXRxNFpTYThvVkgzQ3k4eVBlL0kK",
      "endpoints": [
        "https://github.com/wbai0/pico-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
